generator client {
  provider = "prisma-client-js"
  // Esta linha garante que o binário correto para o ambiente Linux (Vercel) seja incluído.
  binaryTargets = ["native", "rhel-openssl-1.0.x"] 
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model jogos {
  id            String  @id @default(auto()) @map("_id") @db.ObjectId
  bet           String  @unique
  nome          String
  horario       String?
  placar        String?
  status        String?
  estatisticas  Json?
  eventos       Json?
}