generator client {
  provider = "prisma-client-js"
  
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model jogos {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  bet         String @unique
  nome        String
  horario     String
  placar      String
  status      String
  estatisticas Json?
  eventos      Json?
}
