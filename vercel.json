{
  "functions": {
    "api/index.js": {
      "runtime": "nodejs20.x",
      "includeFiles": [
        "src/utils/**",
        "node_modules/.prisma/**",
        "node_modules/@prisma/client/**",
        "prisma/schema.prisma"
      ]
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/(.*)", "status": 404 }
  ]
}
