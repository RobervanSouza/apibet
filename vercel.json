{
  "version": 2,
  "builds": [
    {
      "src": "src/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    
    {
      "src": "/",
      "dest": "/src/index.js" 
    },
   
    {
      "src": "/atualizar-jogos",
      "dest": "/src/index.js"
    },
  
    {
      "src": "/(.*)",
      "dest": "/src/index.js"
    }
  ]
}
