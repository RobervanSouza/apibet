{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "node_modules/.prisma/**",
          "node_modules/@prisma/client/**",
          "prisma/schema.prisma",
          "prisma.js"
        ]
      }
    }
  ],
  "routes": [
    { "src": "/atualizar-jogos", "dest": "index.js" },
    { "src": "/", "dest": "index.js" },
    { "src": "/(.*)", "dest": "index.js" }
  ]
}
